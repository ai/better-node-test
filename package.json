{
  "name": "better-node-test",
  "version": "0.8.4",
  "description": "The CLI shortcut for node --test runner with TypeScript",
  "keywords": [
    "node",
    "test",
    "typescript"
  ],
  "license": "MIT",
  "author": "Andrey Sitnik <andrey@sitnik.es>",
  "repository": "ai/better-node-test",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ai"
    }
  ],
  "bin": {
    "bnt": "./bin.js"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "test:lint": "oxlint",
    "test:case:coverage": "node bin.js --coverage 100 --coverage-exclude '!test/**' test/*.test.js | node test/find.js 'coverage does not meet' '18,20'",
    "test:case:help": "node bin.js --help | node test/find.js Usage",
    "test:case:only": "node bin.js -t two | node test/find.js 'pass 3'",
    "test:case:pathless": "node bin.js | node test/find.js 'tests 7'",
    "test:case:path": "node bin.js test/*.test.js | node test/find.js 'tests 2'",
    "test:case:env": "node bin.js | node test/find.js 'NODE_ENV=test'",
    "test": "pnpm run /^test:/"
  },
  "devDependencies": {
    "@logux/oxc-configs": "^1.0.0",
    "@types/node": "^26.1.1",
    "actions-up": "^1.16.0",
    "eslint": "^10.7.0",
    "eslint-plugin-prefer-let": "^4.2.2",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || >=26.0.0"
  }
}
